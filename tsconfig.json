{
	"compilerOptions": {
		"allowImportingTsExtensions": true,
		"erasableSyntaxOnly": true,
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"noEmit": true,
		"skipLibCheck": true,
		"strict": true,
		"target": "ES2023",
		"types": ["node", "vitest/globals"],
		"verbatimModuleSyntax": true
	},
	"include": ["src/**/*.ts", "test/**/*.ts"]
}

{
	"name": "pi-codex-fast-extension",
	"version": "0.1.0",
	"description": "Enable OpenAI Codex priority processing in Pi",
	"type": "module",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/tedczj/pi-codex-fast-extension.git"
	},
	"keywords": [
		"pi-package",
		"pi-extension",
		"openai",
		"codex",
		"priority-processing"
	],
	"files": [
